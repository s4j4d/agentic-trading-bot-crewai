# Copy to .env and fill in the blanks:  cp .env.example .env
# Shell environment variables take precedence over this file.
# Only the KEY lines are blank; every other line already carries the
# project default, so an unedited copy runs as-is.

# --- LLM provider (OpenAI-compatible; Ollama works) ---
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1
# MODEL=openai/qwen3:14b

# Indicator look-back periods (candles)
COUNCIL_RSI_PERIOD=14
COUNCIL_ATR_PERIOD=14
# Minimum candles required before indicators compute (code default 24)
COUNCIL_MIN_CANDLES=24

# Crew cadence knobs (scheduler tick is always 60s; these gate each crew).
# Accepts a bare number of seconds (7200) or a duration suffix (30m, 2h, 90s, 1d).
#   COUNCIL_SCOUT_INTERVAL_S     market_scout crew   - default 2h
#   COUNCIL_ANALYSIS_INTERVAL_S  analysis + portfolio crews - default 5m
#   COUNCIL_RISK_TICK_INTERVAL_S deterministic SL/TP + max-hold, no LLM - default 60s
COUNCIL_SCOUT_INTERVAL_S=2h
COUNCIL_ANALYSIS_INTERVAL_S=5m
COUNCIL_RISK_TICK_INTERVAL_S=60s

# CrewAI generic conversation memory. Off by default: it adds Ollama embed
# latency on every agent step with no trading value. Real-trading memory is the
# separate trade journal (output/trade_journal.jsonl).
COUNCIL_MEMORY=false
USE_MEMORY=false  # legacy alias, ignored when COUNCIL_MEMORY is set

# Max position hold before forced close (days)
COUNCIL_MAX_HOLD_DAYS=1

# Wall-clock budget (seconds) for the market-scout agent; blank/junk/<=0 falls back to 500
COUNCIL_SCOUT_MAX_EXECUTION_TIME=500

# Parallel analysis workers per cycle
COUNCIL_ANALYSIS_WORKERS=3

# Allowed deviation (%) between crew-explicit SL/TP and computed ATR levels
# before the deterministic ATR values are used instead
COUNCIL_RISK_LEVEL_TOLERANCE_PCT=20

# OHLC cache TTL in seconds
COUNCIL_OHLC_TTL_S=300

# Use the configured exchange for OHLC data instead of CoinGecko
USE_EXCHANGE_OHLC=false
# OTEL SDK is force-disabled at import (main.py sets it unconditionally).
OTEL_SDK_DISABLED=true

# Comma-separated news RSS feeds (swap providers without code changes)
CRYPTO_NEWS_SENTIMENT=https://cointelegraph.com/rss,https://www.coindesk.com/arc/outboundfeeds/rss/,https://decrypt.co/feed

# NewsData API key (optional news provider)
NEWSDATA_API_KEY=

# Exchange backend
EXCHANGE=nobitex
EXCHANGE_API_BASE=https://apiv2.nobitex.ir
# Two auth schemes are supported; the client picks from which credentials
# are set, and never mixes the two sources.
#
#   1) Legacy v2 token — set a token only:
#        EXCHANGE_API_KEY=<token>   (sent as `Authorization: Token <token>`)
#
#   2) Ed25519 API key — set the PAIR (both, or neither is half-configured):
#        EXECUTION_API_KEY=<public key Nobitex shows as `key`>
#        EXECUTION_API_SECRET=<private-key seed, shown once at creation>
#
# The API-key scheme signs every request: `Nobitex-Key`,
# `Nobitex-Signature` (Ed25519 over timestamp+METHOD+full_path+raw_body),
# `Nobitex-Timestamp`. Nobitex tolerates 30s of clock skew, so the system
# clock must be roughly right or every request is rejected.
#
# Use a TRADE- (not WITHDRAWAL-) scoped key with an IP allowlist, and rotate
# it if this file is ever shared.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=      # legacy v2 token secret; falls back pair-wise with the key above
EXCHANGE_QUOTE=rls

# Execution mode: paper (default) | live | halted (kill switch).
# Paper simulates fills locally; live places real spot orders via
# NobitexExecutionClient.apply_plan (Phase 4); halted refuses to trade.
EXECUTION_MODE=paper
EXECUTION_API_KEY=          # Nobitex-Key (public API key); falls back to EXCHANGE_API_KEY
EXECUTION_API_SECRET=       # Ed25519 private-key seed; falls back to EXCHANGE_API_SECRET
EXECUTION_API_BASE=         # falls back to EXCHANGE_API_BASE (https://apiv2.nobitex.ir)
EXECUTION_QUOTE=             # quote currency; falls back to EXCHANGE_QUOTE (rls)
# EXECUTION_EXCHANGE=nobitex  # live venue; falls back to EXCHANGE
# Dust filter: deltas below this quote-currency notional are skipped live
# (mirrors the allocator's min_trade hold rule). 10 is a dust floor only:
# set this >= the venue's minimum-notional (Nobitex /v2/options minimums
# are orders of magnitude larger) or every live order is SmallOrder-rejected.
EXECUTION_MIN_TRADE=10
# true = build live orders without POSTing (safe rehearsal); default false
EXECUTION_DRY_RUN=false
EXECUTION_LOG_PATH=output/live_executions.jsonl  # per-cycle live audit log
# Simulated venue fee in basis points (paper mode only; default 0 = legacy).
# Transport retries per request (code default 3) and HTTP timeout in seconds (default 20)
EXECUTION_MAX_RETRIES=3
EXECUTION_TIMEOUT=20
# Rounding precision for prices/quantities (default 8)
EXECUTION_PRICE_DECIMALS=8
EXECUTION_QTY_DECIMALS=8
# HTTP user-agent sent on venue requests
EXECUTION_USER_AGENT=TraderBot/crypto-council-1.0
# Explicit minimum-notional floor; blank = venue /v2/options minOrders lookup.
# Per-quote override form: EXECUTION_MIN_NOTIONAL_RLS / EXECUTION_MIN_NOTIONAL_USDT
EXECUTION_MIN_NOTIONAL=
PAPER_FEE_BPS=0

# Phase 5 — live reconciliation is automatic: with EXECUTION_MODE=live the
# portfolio cycle pulls venue fills after apply_plan and rebuilds
# output/live_positions.json + output/live_ledger.json from wallet balances.
# Reconciliation is advisory — if it fails the cycle continues and the
# previous local state is kept, so trading is never blocked by it.
# Ledger provenance follows the snapshot itself: the status panel
# (scripts/portfolio_panel.py) reads output/live_ledger.json for a live
# snapshot and output/paper_ledger.json otherwise, so no extra knob is
# needed. `--mode live|paper` forces one when inspecting the other.

# Phase 6 — pre-trade safety, live mode only. Capital caps re-check every
# order at fill time against the wallet (a plan is priced on the last known
# price, an order fills at the current one), and the daily realized-loss
# breaker stops new entries once today's loss passes its budget. Both are
# normally threaded from the CLI flags (--max-total-exposure /
# --max-single-position), so these env vars are only the fallback for a
# standalone client — set both or neither.
# EXECUTION_MAX_TOTAL_PCT=0.30       # total exposure cap, FRACTION of account
#   (0.30 = 30%). A value above 1.0 is a units error — it is rejected
#   rather than armed as an inert cap that blocks nothing.
# EXECUTION_MAX_SINGLE_PCT=0.05     # single-position cap, FRACTION of account
#   (0.05 = 5%). "One position" means the post-trade exposure, so a
#   holding you already have counts against it.
# Daily-loss budget, PERCENT of account (5.0 = 5%, not 0.05). Negative
# disables the breaker; 0 refuses every new entry. It fails CLOSED (raises
# ExecutionHalted via CircuitBreakerOpen) and never demotes to paper,
# while sells/closes stay allowed so a losing position can always be
# unwound. Deterministic, so dry_run rehearsals skip it.
EXECUTION_MAX_DAILY_LOSS_PCT=5.0
