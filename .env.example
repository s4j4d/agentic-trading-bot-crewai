# Copy to .env and fill in the blanks:  cp .env.example .env
# Shell environment variables take precedence over this file.
# Only the KEY lines are blank; every other line already carries the
# project default, so an unedited copy runs as-is.

# --- LLM provider (OpenAI-compatible; Ollama works) ---
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1
# MODEL=openai/qwen3:14b

# Indicator look-back periods (candles)
COUNCIL_RSI_PERIOD=14
COUNCIL_ATR_PERIOD=14

# Crew cadence knobs (scheduler tick is always 60s; these gate each crew).
# Accepts a bare number of seconds (7200) or a duration suffix (30m, 2h, 90s, 1d).
#   COUNCIL_SCOUT_INTERVAL_S     market_scout crew   - default 2h
#   COUNCIL_ANALYSIS_INTERVAL_S  analysis + portfolio crews - default 5m
#   COUNCIL_RISK_TICK_INTERVAL_S deterministic SL/TP + max-hold, no LLM - default 60s
COUNCIL_SCOUT_INTERVAL_S=2h
COUNCIL_ANALYSIS_INTERVAL_S=5m
COUNCIL_RISK_TICK_INTERVAL_S=60s

# CrewAI generic conversation memory. Off by default: it adds Ollama embed
# latency on every agent step with no trading value. Real-trading memory is the
# separate trade journal (output/trade_journal.jsonl).
COUNCIL_MEMORY=false
# USE_MEMORY=false  # legacy alias, ignored when COUNCIL_MEMORY is set

# Max position hold before forced close (days)
COUNCIL_MAX_HOLD_DAYS=1

# Parallel analysis workers per cycle
COUNCIL_ANALYSIS_WORKERS=3

# Allowed deviation (%) between crew-explicit SL/TP and computed ATR levels
# before the deterministic ATR values are used instead
COUNCIL_RISK_LEVEL_TOLERANCE_PCT=20

# OHLC cache TTL in seconds
COUNCIL_OHLC_TTL_S=300

# Use the configured exchange for OHLC data instead of CoinGecko
USE_EXCHANGE_OHLC=false

# Comma-separated news RSS feeds (swap providers without code changes)
CRYPTO_NEWS_SENTIMENT=https://cointelegraph.com/rss,https://www.coindesk.com/arc/outboundfeeds/rss/,https://decrypt.co/feed

# NewsData API key (optional news provider)
NEWSDATA_API_KEY=

# Exchange backend
EXCHANGE=nobitex
EXCHANGE_API_BASE=https://apiv2.nobitex.ir
EXCHANGE_API_KEY=
EXCHANGE_QUOTE=rls
